@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }

    ViewData["Title"] ??= "Account Settings";
}

<div class="manage-page">

    <section class="manage-page-header">
        <div>
            <span class="manage-page-eyebrow">RACEDAY ACCOUNT</span>
            <h1>Manage your account</h1>
            <p>Update your profile, manage security and control your account settings.</p>
        </div>
    </section>

    <div class="manage-page-layout">
        <aside class="manage-page-sidebar">
            <partial name="_ManageNav" />
        </aside>

        <main class="manage-page-content">
            @RenderBody()
        </main>
    </div>

</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
