
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.styles.css" asp-append-version="true" />
</head>

<body>

    <header class="main-header">
        <nav class="main-nav">

            <a class="brand-logo"
               asp-controller="Home"
               asp-action="Index">
                <span class="brand-symbol">R</span>
                <span>Race<span class="brand-light">Day</span></span>
            </a>

            <button class="nav-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="main-navigation collapse" id="mainNavigation">

                <ul class="nav-links">
                    <li>
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    <li>
                        <a asp-controller="Events" asp-action="Index">Explore Events</a>
                    </li>

                    @if (User.IsInRole("Admin") || User.IsInRole("Organiser"))
                    {
                        <li>
                            <a asp-controller="Events" asp-action="Index">Manage Events</a>
                        </li>

                        <li>
                            <a asp-controller="Results" asp-action="Capture">Results</a>
                        </li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li>
                            <a asp-controller="UserRoles" asp-action="Index">Users</a>
                        </li>
                    }

                    @if (User.IsInRole("Participant"))
                    {
                        <li>
                            <a asp-controller="Enrolments" asp-action="My">My Enrolments</a>
                        </li>

                        <li>
                            <a asp-controller="Results" asp-action="My">My Results</a>
                        </li>
                    }

                    <li>
                        <a asp-controller="Home" asp-action="Privacy">About</a>
                    </li>
                </ul>

                <div class="nav-account">
                    <partial name="_LoginPartial" />

                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Events"
                           asp-action="Index"
                           class="nav-join-button">
                            Get Started <span>↗</span>
                        </a>
                    }
                </div>

            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="footer-top">

            <div class="footer-brand">
                <a asp-controller="Home" asp-action="Index" class="brand-logo">
                    <span class="brand-symbol">R</span>
                    <span>Race<span class="brand-light">Day</span></span>
                </a>

                <p>
                    Every race has a story.<br />
                    Make yours count.
                </p>
            </div>

            <div class="footer-links">
                <div>
                    <span class="footer-heading">DISCOVER</span>
                    <a asp-controller="Events" asp-action="Index">Events</a>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                </div>

                <div>
                    <span class="footer-heading">ACCOUNT</span>
                    <a asp-controller="Enrolments" asp-action="My">My Enrolments</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <span>© 2026 RaceDay. All rights reserved.</span>
            <span>BUILT FOR EVERY FINISH LINE.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
