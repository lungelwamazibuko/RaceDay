@using Microsoft.AspNetCore.Identity
@using RaceDay.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);

    <div class="login-partial">
        <a class="login-account-link"
           asp-area="Identity"
           asp-page="/Account/Manage/Index"
           title="Manage account">

            <img src="@(user?.ProfileImagePath ?? "/images/default-avatar.png")"
                 class="login-avatar"
                 alt="Profile" />

            <span>Hello, @(user?.FirstName ?? User.Identity?.Name)!</span>
        </a>

        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
              method="post">

            <button type="submit" class="login-logout-button">
                Logout
            </button>
        </form>
    </div>
}
else
{
    <div class="login-partial">
        <a class="login-signin-link"
           asp-area="Identity"
           asp-page="/Account/Login">
            Login
        </a>

        <a class="login-register-button"
           asp-area="Identity"
           asp-page="/Account/Register">
            Register <span>↗</span>
        </a>
    </div>
}
